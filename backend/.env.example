# Environment Config
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/portfolio

# Authentication Secrets (Must be random secure strings in production)
JWT_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here

# CORS (Allowed origins)
# For production on Render, set this to your exact Vercel frontend URL
# Example for local: http://localhost:3000
# Example for production: https://saifulislam.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Canonical Domain used by backend SEO services (e.g. for generating Sitemap manifest XML)
CANONICAL_DOMAIN=https://saifulislam.vercel.app
